# Normalize text to LF in the repo so Linux/devcontainer scripts never get CRLF from Windows checkouts.
* text=auto eol=lf

# Explicit text types
*.c     text eol=lf
*.h     text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
Dockerfile text eol=lf
wscript    text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-only scripts keep CRLF when present
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.pbw  binary
*.elf  binary
*.map  binary
