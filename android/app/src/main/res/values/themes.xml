<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- NoActionBar: toolbar lives in each layout so content cannot draw under the header
         (Android 15 edge-to-edge otherwise starts content at y=0 under the system ActionBar). -->
    <style name="Theme.EzSos" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#C62828</item>
        <item name="colorPrimaryVariant">#8E0000</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">#455A64</item>
        <item name="android:statusBarColor">#8E0000</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>
